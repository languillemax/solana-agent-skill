{
  "name": "solana-agent-skill",
  "version": "1.0.0",
  "description": "Solana Agent Skill Kit - Autonomous agent actions on-chain",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsc --noEmit && npx tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "t3n:smoke": "tsx src/t3n-smoke.ts",
    "t3n:create-org": "tsx src/t3n-create-org.ts",
    "t3n:create-agent": "tsx src/t3n-create-agent.ts",
    "t3n:agent-whoami": "tsx src/t3n-agent-whoami.ts",
    "t3n:agent-contracts": "tsx src/t3n-agent-list-contracts.ts",
    "t3n:org-contracts": "tsx src/t3n-org-contracts.ts",
    "t3n:publish-guard": "tsx src/t3n-publish-solana-guard.ts",
    "t3n:grant-guard": "tsx src/t3n-grant-solana-guard.ts",
    "t3n:authorize-smoke": "tsx src/t3n-authorize-session-smoke.ts",
    "t3n:delegation-check": "tsx src/t3n-delegation-check.ts",
    "t3n:grant-org-guard": "tsx src/t3n-grant-org-solana-guard.ts",
    "t3n:authorize-agent-smoke": "tsx src/t3n-agent-authorize-smoke.ts"
  },
  "keywords": [
    "solana",
    "agent",
    "ai",
    "web3",
    "automation"
  ],
  "author": "languillemax",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@terminal3/t3n-sdk": "^5.15.2",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
