{
  "name": "solana-agent-skill",
  "version": "1.0.0",
  "description": "Solana Agent Skill Kit - Autonomous agent actions on-chain",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsc --noEmit && npx tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "solana",
    "agent",
    "ai",
    "web3",
    "automation"
  ],
  "author": "languillemax",
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "cross-fetch": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
